# Copy to .env and fill in values locally. .env is git-ignored; never commit it.
# This file lists variable NAMES only. It must never contain a value (a test enforces this).
# The same names go into GitHub Actions secrets where CI needs them.

# LLM providers (PLAN.md S0.5)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Hugging Face Hub read-only token (optional; S3.2 research does not require it)
HF_TOKEN=
