# Normalize every text file to LF in the repo and in working trees, on Windows and Linux alike.
* text=auto eol=lf

# Binary formats: never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.parquet binary
*.ckpt binary
*.pt binary
*.pth binary
*.safetensors binary
*.joblib binary
*.pkl binary
*.skops binary
*.sqlite binary
*.db binary
