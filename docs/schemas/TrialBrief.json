{
  "$defs": {
    "ActorRole": {
      "description": "Who acted: an LLM role (spec §6.3, §22.1 `roles/`) or a platform component.",
      "enum": [
        "intake",
        "supervisor",
        "research_lead",
        "research_worker",
        "data_lead",
        "diagnostic_worker",
        "training_lead",
        "trial_worker",
        "optimization_worker",
        "reviewer",
        "reporter",
        "single_agent",
        "controller",
        "scheduler",
        "policy_engine",
        "verifier",
        "harness",
        "execution_worker",
        "mcp_server",
        "external_client",
        "user"
      ],
      "title": "ActorRole",
      "type": "string"
    },
    "BriefBudget": {
      "additionalProperties": false,
      "description": "Worker stop conditions (spec §6.4 `budget`, §6.8 worker row).",
      "properties": {
        "max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_tool_calls": {
          "exclusiveMinimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        }
      },
      "required": [
        "max_tool_calls",
        "max_tokens"
      ],
      "title": "BriefBudget",
      "type": "object"
    },
    "CostEstimate": {
      "additionalProperties": false,
      "description": "Estimated cost of running something (`estimate_experiment`, spec §8.3).",
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "compute_seconds": {
          "minimum": 0,
          "title": "Compute Seconds",
          "type": "number"
        },
        "gpu": {
          "default": false,
          "title": "Gpu",
          "type": "boolean"
        },
        "peak_memory_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Memory Gb"
        },
        "usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Usd",
          "type": "number"
        }
      },
      "required": [
        "compute_seconds"
      ],
      "title": "CostEstimate",
      "type": "object"
    },
    "JsonValue": {},
    "Operation": {
      "description": "Job operation (spec §12 `submit_experiment`).",
      "enum": [
        "fit",
        "eval_as_is",
        "finetune",
        "optimize",
        "profile"
      ],
      "title": "Operation",
      "type": "string"
    },
    "ShortBudget": {
      "additionalProperties": false,
      "description": "Reduced budget for a successive-halving round (spec §8.4).",
      "properties": {
        "data_fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Fraction"
        },
        "max_epochs": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Epochs"
        },
        "max_wall_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Seconds"
        }
      },
      "title": "ShortBudget",
      "type": "object"
    },
    "ToolName": {
      "description": "Every tool the spec names: §12 (MCP server), §6.3 (role tools), §11 (tier examples).",
      "enum": [
        "inspect_environment",
        "inspect_dataset",
        "run_diagnostic",
        "search_model_catalog",
        "get_model_evidence",
        "retrieve_methodology",
        "estimate_experiment",
        "write_trial_files",
        "submit_experiment",
        "get_experiment_status",
        "get_experiment_logs",
        "get_experiment_metrics",
        "profile_model",
        "compare_experiments",
        "cancel_experiment",
        "export_artifacts",
        "delegate",
        "propose_trials",
        "escalate",
        "ask_user",
        "create_experiment",
        "share_samples"
      ],
      "title": "ToolName",
      "type": "string"
    },
    "TrialKind": {
      "description": "`trials.kind`, spec §15.1.",
      "enum": [
        "baseline",
        "candidate",
        "eval_as_is",
        "finetune",
        "optimization"
      ],
      "title": "TrialKind",
      "type": "string"
    },
    "TrialSpec": {
      "additionalProperties": false,
      "description": "A trial as recorded by the controller (`trials` table, spec §15.1).",
      "properties": {
        "batch_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Batch Id",
          "type": "string"
        },
        "config": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Config",
          "type": "object"
        },
        "contract_version": {
          "exclusiveMinimum": 0,
          "title": "Contract Version",
          "type": "integer"
        },
        "estimated_cost": {
          "$ref": "#/$defs/CostEstimate"
        },
        "expected_effect": {
          "minLength": 1,
          "title": "Expected Effect",
          "type": "string"
        },
        "hypothesis": {
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TrialKind"
        },
        "model_family": {
          "description": "e.g. 'hist_gradient_boosting', 'resnet18'.",
          "minLength": 1,
          "title": "Model Family",
          "type": "string"
        },
        "model_ref": {
          "anyOf": [
            {
              "maxLength": 320,
              "pattern": "^[^\\s@]+@[^\\s@]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pretrained weights, pinned.",
          "title": "Model Ref"
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "parent_trial_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set for optimization variants.",
          "title": "Parent Trial Id"
        },
        "run_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "short_budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShortBudget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trial_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Trial Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "operation",
        "hypothesis",
        "model_family",
        "expected_effect",
        "estimated_cost",
        "trial_id",
        "run_id",
        "batch_id",
        "contract_version"
      ],
      "title": "TrialSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Brief for one trial worker: one TrialSpec plus templates (spec §6.3).",
  "properties": {
    "allowed_tools": {
      "items": {
        "$ref": "#/$defs/ToolName"
      },
      "minItems": 1,
      "title": "Allowed Tools",
      "type": "array"
    },
    "assigned_role": {
      "const": "trial_worker",
      "default": "trial_worker",
      "title": "Assigned Role",
      "type": "string"
    },
    "brief_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Brief Id",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/BriefBudget"
    },
    "context_refs": {
      "items": {
        "maxLength": 512,
        "pattern": "^[a-z][a-z0-9_]*:\\S+$",
        "type": "string"
      },
      "title": "Context Refs",
      "type": "array"
    },
    "contract_ref": {
      "description": "e.g. 'experiment_contract:v1'.",
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9_]*:\\S+$",
      "title": "Contract Ref",
      "type": "string"
    },
    "end_condition": {
      "minLength": 1,
      "title": "End Condition",
      "type": "string"
    },
    "issued_by": {
      "$ref": "#/$defs/ActorRole"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "output_schema": {
      "const": "TrialFinding",
      "default": "TrialFinding",
      "title": "Output Schema",
      "type": "string"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "template_refs": {
      "description": "e.g. 'template:tabular/hist_gradient_boosting'.",
      "items": {
        "maxLength": 512,
        "pattern": "^[a-z][a-z0-9_]*:\\S+$",
        "type": "string"
      },
      "title": "Template Refs",
      "type": "array"
    },
    "trial": {
      "$ref": "#/$defs/TrialSpec"
    }
  },
  "required": [
    "brief_id",
    "run_id",
    "issued_by",
    "objective",
    "allowed_tools",
    "end_condition",
    "budget",
    "trial",
    "contract_ref"
  ],
  "title": "TrialBrief",
  "type": "object"
}
