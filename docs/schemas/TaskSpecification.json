{
  "$defs": {
    "ActorRole": {
      "description": "Who acted: an LLM role (spec §6.3, §22.1 `roles/`) or a platform component.",
      "enum": [
        "intake",
        "supervisor",
        "research_lead",
        "research_worker",
        "data_lead",
        "diagnostic_worker",
        "training_lead",
        "trial_worker",
        "optimization_worker",
        "reviewer",
        "reporter",
        "single_agent",
        "controller",
        "scheduler",
        "policy_engine",
        "verifier",
        "harness",
        "execution_worker",
        "mcp_server",
        "external_client",
        "user"
      ],
      "title": "ActorRole",
      "type": "string"
    },
    "ApprovalPolicy": {
      "description": "Spec §10.3.",
      "enum": [
        "interactive",
        "auto_within_contract"
      ],
      "title": "ApprovalPolicy",
      "type": "string"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "Run-level limits (spec §6.8 run stop conditions; `runs.budget_*`). Unset = no limit.",
      "properties": {
        "max_compute_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Job compute time.",
          "title": "Max Compute Seconds"
        },
        "max_llm_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Llm Tokens"
        },
        "max_steps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Max controller steps in the run.",
          "title": "Max Steps"
        },
        "max_trials": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Trials"
        },
        "max_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "LLM + external API spend, USD.",
          "title": "Max Usd"
        },
        "max_wall_clock_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Clock Seconds"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Clarification": {
      "additionalProperties": false,
      "description": "One high-value clarification the Intake role asked (spec §5.2).",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        },
        "asked_by": {
          "$ref": "#/$defs/ActorRole",
          "default": "intake"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "DataLocality": {
      "description": "Whether data may leave the user's machine (spec §5.2 hard constraints, §7.1 path A).",
      "enum": [
        "local_only",
        "hosted_api_allowed"
      ],
      "title": "DataLocality",
      "type": "string"
    },
    "Device": {
      "enum": [
        "cpu",
        "gpu"
      ],
      "title": "Device",
      "type": "string"
    },
    "Family": {
      "description": "Model family route (spec §5.2 Route, §18).",
      "enum": [
        "tabular",
        "vision",
        "timeseries",
        "experimental"
      ],
      "title": "Family",
      "type": "string"
    },
    "MetricName": {
      "description": "Metrics computed by platform code (spec §18; PLAN.md S1.3).",
      "enum": [
        "accuracy",
        "balanced_accuracy",
        "precision",
        "recall",
        "f1",
        "precision_macro",
        "recall_macro",
        "f1_macro",
        "roc_auc",
        "pr_auc",
        "log_loss",
        "brier_score",
        "mae",
        "rmse",
        "r2"
      ],
      "title": "MetricName",
      "type": "string"
    },
    "RequestedAction": {
      "description": "What the user asked for (spec §3 first-class actions). Drives Phase B entry (spec §5.3).",
      "enum": [
        "feasibility_analysis",
        "model_search",
        "evaluate_as_is",
        "train",
        "fine_tune",
        "optimize_inference",
        "research_experimental"
      ],
      "title": "RequestedAction",
      "type": "string"
    },
    "ResourceConstraints": {
      "additionalProperties": false,
      "description": "Inference-time constraints the user sets (spec §3 examples, §8.5).",
      "properties": {
        "latency_batch_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Batch Size"
        },
        "latency_device": {
          "anyOf": [
            {
              "$ref": "#/$defs/Device"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_latency_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Latency Ms"
        },
        "max_memory_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Memory Mb"
        },
        "max_model_size_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Size Mb"
        },
        "min_throughput_per_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Throughput Per S"
        }
      },
      "title": "ResourceConstraints",
      "type": "object"
    },
    "TaskType": {
      "description": "Prediction task (spec §18 scopes).",
      "enum": [
        "binary_classification",
        "multiclass_classification",
        "multilabel_classification",
        "regression",
        "forecasting",
        "window_classification"
      ],
      "title": "TaskType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The user's objective and hard constraints, as understood by Intake (spec §5.2, §3, §10).",
  "properties": {
    "allow_gpu": {
      "default": false,
      "title": "Allow Gpu",
      "type": "boolean"
    },
    "approval_policy": {
      "$ref": "#/$defs/ApprovalPolicy",
      "default": "interactive"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "clarifications": {
      "items": {
        "$ref": "#/$defs/Clarification"
      },
      "title": "Clarifications",
      "type": "array"
    },
    "data_locality": {
      "$ref": "#/$defs/DataLocality",
      "default": "local_only"
    },
    "dataset_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Path/URI of the authorized dataset.",
      "title": "Dataset Ref"
    },
    "exclusion_rules": {
      "description": "Plain-language exclusions, e.g. 'no measurements recorded after the reaction'. The Data branch resolves them to columns.",
      "items": {
        "type": "string"
      },
      "title": "Exclusion Rules",
      "type": "array"
    },
    "existing_model_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The user's own model to evaluate or optimize.",
      "title": "Existing Model Ref"
    },
    "family_hint": {
      "anyOf": [
        {
          "$ref": "#/$defs/Family"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "forbidden_columns": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Columns",
      "type": "array"
    },
    "from_form": {
      "description": "Fields set from structured form inputs rather than chat (spec §5.2).",
      "items": {
        "type": "string"
      },
      "title": "From Form",
      "type": "array"
    },
    "max_quality_degradation": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Allowed primary-metric loss for optimization, e.g. 0.01 = 1 pt of F1.",
      "title": "Max Quality Degradation"
    },
    "named_models": {
      "description": "Models the user named (spec §8.3).",
      "items": {
        "maxLength": 256,
        "pattern": "^[^\\s@]+$",
        "type": "string"
      },
      "title": "Named Models",
      "type": "array"
    },
    "objective": {
      "description": "The user's goal in plain language.",
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "primary_metric": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricName"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "quality_target": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Threshold on primary_metric, in the metric's own units.",
      "title": "Quality Target"
    },
    "requested_actions": {
      "items": {
        "$ref": "#/$defs/RequestedAction"
      },
      "minItems": 1,
      "title": "Requested Actions",
      "type": "array"
    },
    "resource_constraints": {
      "$ref": "#/$defs/ResourceConstraints"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "secondary_metrics": {
      "items": {
        "$ref": "#/$defs/MetricName"
      },
      "title": "Secondary Metrics",
      "type": "array"
    },
    "share_samples": {
      "default": false,
      "description": "Spec §4.3 grant; off by default.",
      "title": "Share Samples",
      "type": "boolean"
    },
    "target": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    },
    "task_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "version": {
      "description": "Increments when the spec is revised (`task_specs`).",
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "version",
    "objective",
    "requested_actions"
  ],
  "title": "TaskSpecification",
  "type": "object"
}
