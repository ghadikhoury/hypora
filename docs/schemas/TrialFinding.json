{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 512,
            "pattern": "^[a-z][a-z0-9_]*:\\S+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement"
      ],
      "title": "Claim",
      "type": "object"
    },
    "FindingStatus": {
      "description": "How the worker's brief ended (spec §6.8 worker stop conditions).",
      "enum": [
        "complete",
        "budget_exhausted",
        "failed"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "TrialOutcome": {
      "enum": [
        "submitted",
        "completed",
        "failed",
        "abandoned"
      ],
      "title": "TrialOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "What a trial worker did; metrics are referenced by result ID, never restated.",
  "properties": {
    "brief_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Brief Id",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "error_codes": {
      "items": {
        "maxLength": 64,
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "type": "string"
      },
      "title": "Error Codes",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 512,
        "pattern": "^[a-z][a-z0-9_]*:\\S+$",
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "files_written": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Files Written",
      "type": "array"
    },
    "fix_attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Fix Attempts",
      "type": "integer"
    },
    "job_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Job Ids",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/TrialOutcome"
    },
    "result_refs": {
      "items": {
        "maxLength": 512,
        "pattern": "^[a-z][a-z0-9_]*:\\S+$",
        "type": "string"
      },
      "title": "Result Refs",
      "type": "array"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/FindingStatus"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "trial_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Trial Id",
      "type": "string"
    }
  },
  "required": [
    "brief_id",
    "run_id",
    "status",
    "confidence",
    "trial_id",
    "outcome",
    "summary"
  ],
  "title": "TrialFinding",
  "type": "object"
}
