{
  "$defs": {
    "ApprovalPolicy": {
      "description": "Spec §10.3.",
      "enum": [
        "interactive",
        "auto_within_contract"
      ],
      "title": "ApprovalPolicy",
      "type": "string"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "Run-level limits (spec §6.8 run stop conditions; `runs.budget_*`). Unset = no limit.",
      "properties": {
        "max_compute_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Job compute time.",
          "title": "Max Compute Seconds"
        },
        "max_llm_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Llm Tokens"
        },
        "max_steps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Max controller steps in the run.",
          "title": "Max Steps"
        },
        "max_trials": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Trials"
        },
        "max_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "LLM + external API spend, USD.",
          "title": "Max Usd"
        },
        "max_wall_clock_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Clock Seconds"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "CostEstimate": {
      "additionalProperties": false,
      "description": "Estimated cost of running something (`estimate_experiment`, spec §8.3).",
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "compute_seconds": {
          "minimum": 0,
          "title": "Compute Seconds",
          "type": "number"
        },
        "gpu": {
          "default": false,
          "title": "Gpu",
          "type": "boolean"
        },
        "peak_memory_gb": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Memory Gb"
        },
        "usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Usd",
          "type": "number"
        }
      },
      "required": [
        "compute_seconds"
      ],
      "title": "CostEstimate",
      "type": "object"
    },
    "ProposedMeasurement": {
      "additionalProperties": false,
      "description": "One candidate the Phase B plan would measure (spec §7.1 'proposed Phase B plan').",
      "properties": {
        "estimated_cost": {
          "$ref": "#/$defs/CostEstimate"
        },
        "option_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "title": "Option Id",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "trial_kind": {
          "$ref": "#/$defs/TrialKind"
        }
      },
      "required": [
        "option_id",
        "trial_kind",
        "rationale",
        "estimated_cost"
      ],
      "title": "ProposedMeasurement",
      "type": "object"
    },
    "ProposedPhaseBPlan": {
      "additionalProperties": false,
      "properties": {
        "measurements": {
          "items": {
            "$ref": "#/$defs/ProposedMeasurement"
          },
          "minItems": 1,
          "title": "Measurements",
          "type": "array"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "measurements"
      ],
      "title": "ProposedPhaseBPlan",
      "type": "object"
    },
    "Recommendation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/RecommendationKind"
        },
        "option_ids": {
          "default": [],
          "description": "Options this recommendation selects, in order.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Option Ids",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "rationale"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "RecommendationKind": {
      "enum": [
        "no_model_needed",
        "use_hosted_api",
        "reuse_pretrained",
        "evaluate_pretrained_then_finetune_if_needed",
        "fine_tune",
        "train_task_specific",
        "infeasible"
      ],
      "title": "RecommendationKind",
      "type": "string"
    },
    "TrialKind": {
      "description": "`trials.kind`, spec §15.1.",
      "enum": [
        "baseline",
        "candidate",
        "eval_as_is",
        "finetune",
        "optimization"
      ],
      "title": "TrialKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The artifact shown at the plan + budget gate (spec §5.2, §10.2).\n\nIt is \"approved\" when an ApprovalRecord with decision `approved` references its\n`content_hash()`. Any change produces a different hash, so approval resets.",
  "properties": {
    "approval_policy": {
      "$ref": "#/$defs/ApprovalPolicy"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "data_contract_hash": {
      "description": "content_hash() of that DataContract.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Data Contract Hash",
      "type": "string"
    },
    "data_contract_version": {
      "exclusiveMinimum": 0,
      "title": "Data Contract Version",
      "type": "integer"
    },
    "phase_b_plan": {
      "$ref": "#/$defs/ProposedPhaseBPlan"
    },
    "recommendation": {
      "$ref": "#/$defs/Recommendation"
    },
    "requested_dependencies": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Requested Dependencies",
      "type": "array"
    },
    "requested_model_downloads": {
      "default": [],
      "items": {
        "maxLength": 320,
        "pattern": "^[^\\s@]+@[^\\s@]+$",
        "type": "string"
      },
      "title": "Requested Model Downloads",
      "type": "array"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "version",
    "recommendation",
    "phase_b_plan",
    "data_contract_version",
    "data_contract_hash",
    "budget",
    "approval_policy"
  ],
  "title": "ApprovedPlan",
  "type": "object"
}
