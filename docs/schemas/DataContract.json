{
  "$defs": {
    "CastDtypeFix": {
      "additionalProperties": false,
      "properties": {
        "cast_dtype": {
          "$ref": "#/$defs/DtypeCast"
        }
      },
      "required": [
        "cast_dtype"
      ],
      "title": "CastDtypeFix",
      "type": "object"
    },
    "DropColumnFix": {
      "additionalProperties": false,
      "properties": {
        "drop_column": {
          "minLength": 1,
          "title": "Drop Column",
          "type": "string"
        }
      },
      "required": [
        "drop_column"
      ],
      "title": "DropColumnFix",
      "type": "object"
    },
    "DtypeCast": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "dtype": {
          "minLength": 1,
          "title": "Dtype",
          "type": "string"
        }
      },
      "required": [
        "column",
        "dtype"
      ],
      "title": "DtypeCast",
      "type": "object"
    },
    "ExcludedFeature": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
              "type": "string"
            },
            {
              "maxLength": 512,
              "pattern": "^[a-z][a-z0-9_]*:\\S+$",
              "type": "string"
            }
          ],
          "description": "A diagnostic ID as in spec §7.2 ('diag_017'), or a typed reference such as 'task_spec:v1' when the exclusion comes from the user's own instruction.",
          "title": "Evidence"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "name",
        "reason",
        "evidence"
      ],
      "title": "ExcludedFeature",
      "type": "object"
    },
    "MissingMarker": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "column",
        "values"
      ],
      "title": "MissingMarker",
      "type": "object"
    },
    "ParseDatetimeFix": {
      "additionalProperties": false,
      "properties": {
        "parse_datetime": {
          "minLength": 1,
          "title": "Parse Datetime",
          "type": "string"
        }
      },
      "required": [
        "parse_datetime"
      ],
      "title": "ParseDatetimeFix",
      "type": "object"
    },
    "SetMissingFix": {
      "additionalProperties": false,
      "properties": {
        "set_missing": {
          "$ref": "#/$defs/MissingMarker"
        }
      },
      "required": [
        "set_missing"
      ],
      "title": "SetMissingFix",
      "type": "object"
    },
    "SplitSpec": {
      "additionalProperties": false,
      "description": "How held-out data is carved (spec §7.2 `split`, plus `time_key` per D-004).",
      "properties": {
        "group_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Key"
        },
        "strategy": {
          "$ref": "#/$defs/SplitStrategy"
        },
        "test_fraction": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Test Fraction",
          "type": "number"
        },
        "time_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time column for temporal strategies (D-004).",
          "title": "Time Key"
        },
        "validation": {
          "pattern": "^(holdout|(kfold|stratified_kfold|group_kfold|walk_forward)_([2-9]|[1-9][0-9]))$",
          "title": "Validation",
          "type": "string"
        }
      },
      "required": [
        "strategy",
        "test_fraction",
        "validation"
      ],
      "title": "SplitSpec",
      "type": "object"
    },
    "SplitStrategy": {
      "enum": [
        "random",
        "stratified",
        "group",
        "temporal",
        "group_temporal"
      ],
      "title": "SplitStrategy",
      "type": "string"
    },
    "TaskType": {
      "description": "Prediction task (spec §18 scopes).",
      "enum": [
        "binary_classification",
        "multiclass_classification",
        "multilabel_classification",
        "regression",
        "forecasting",
        "window_classification"
      ],
      "title": "TaskType",
      "type": "string"
    },
    "UnitConversion": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "from": {
          "minLength": 1,
          "title": "From",
          "type": "string"
        },
        "to": {
          "minLength": 1,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "column",
        "from",
        "to"
      ],
      "title": "UnitConversion",
      "type": "object"
    },
    "UnitConvertFix": {
      "additionalProperties": false,
      "properties": {
        "unit_convert": {
          "$ref": "#/$defs/UnitConversion"
        }
      },
      "required": [
        "unit_convert"
      ],
      "title": "UnitConvertFix",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Model-independent data decisions (spec §7.2, field for field, plus `split.time_key`).",
  "properties": {
    "allowed_features": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Features",
      "type": "array"
    },
    "data_contract_version": {
      "exclusiveMinimum": 0,
      "title": "Data Contract Version",
      "type": "integer"
    },
    "excluded_features": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExcludedFeature"
      },
      "title": "Excluded Features",
      "type": "array"
    },
    "non_learned_fixes": {
      "default": [],
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/ParseDatetimeFix"
          },
          {
            "$ref": "#/$defs/UnitConvertFix"
          },
          {
            "$ref": "#/$defs/DropColumnFix"
          },
          {
            "$ref": "#/$defs/CastDtypeFix"
          },
          {
            "$ref": "#/$defs/SetMissingFix"
          }
        ]
      },
      "title": "Non Learned Fixes",
      "type": "array"
    },
    "open_questions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "risks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "split": {
      "$ref": "#/$defs/SplitSpec"
    },
    "target": {
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "task_type": {
      "$ref": "#/$defs/TaskType"
    }
  },
  "required": [
    "data_contract_version",
    "target",
    "task_type",
    "allowed_features",
    "split"
  ],
  "title": "DataContract",
  "type": "object"
}
