{
  "$defs": {
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "$ref": "#/$defs/VerificationCheck"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 512,
            "pattern": "^[a-z][a-z0-9_]*:\\S+$",
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        }
      },
      "required": [
        "check",
        "status"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "CheckStatus": {
      "enum": [
        "passed",
        "failed",
        "skipped",
        "error"
      ],
      "title": "CheckStatus",
      "type": "string"
    },
    "JsonValue": {},
    "VerificationCheck": {
      "enum": [
        "allowed_features",
        "split_respected",
        "test_labels_not_accessed",
        "metric_recomputation",
        "output_shape",
        "finite_outputs",
        "artifact_loads",
        "learned_transform_leakage",
        "numerical_tolerance",
        "heldout_quality_delta",
        "latency_protocol",
        "resource_limits"
      ],
      "title": "VerificationCheck",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic verdict on one trial (spec §8.6). Produced by code, never by an LLM.",
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "contract_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Hash",
      "type": "string"
    },
    "contract_version": {
      "exclusiveMinimum": 0,
      "title": "Contract Version",
      "type": "integer"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "trial_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Trial Id",
      "type": "string"
    }
  },
  "required": [
    "trial_id",
    "run_id",
    "contract_version",
    "contract_hash",
    "passed",
    "checks"
  ],
  "title": "VerificationResult",
  "type": "object"
}
