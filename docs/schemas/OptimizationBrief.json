{
  "$defs": {
    "ActorRole": {
      "description": "Who acted: an LLM role (spec §6.3, §22.1 `roles/`) or a platform component.",
      "enum": [
        "intake",
        "supervisor",
        "research_lead",
        "research_worker",
        "data_lead",
        "diagnostic_worker",
        "training_lead",
        "trial_worker",
        "optimization_worker",
        "reviewer",
        "reporter",
        "single_agent",
        "controller",
        "scheduler",
        "policy_engine",
        "verifier",
        "harness",
        "execution_worker",
        "mcp_server",
        "external_client",
        "user"
      ],
      "title": "ActorRole",
      "type": "string"
    },
    "BriefBudget": {
      "additionalProperties": false,
      "description": "Worker stop conditions (spec §6.4 `budget`, §6.8 worker row).",
      "properties": {
        "max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_tool_calls": {
          "exclusiveMinimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        }
      },
      "required": [
        "max_tool_calls",
        "max_tokens"
      ],
      "title": "BriefBudget",
      "type": "object"
    },
    "Device": {
      "enum": [
        "cpu",
        "gpu"
      ],
      "title": "Device",
      "type": "string"
    },
    "OptimizationMethod": {
      "description": "Inference optimizations (spec §18.1-18.3, PLAN.md S3.C5).",
      "enum": [
        "thread_settings",
        "batch_inference",
        "redundant_transform_removal",
        "serialization_size",
        "export_runtime",
        "torch_compile",
        "fp16",
        "bf16",
        "quantization",
        "input_pipeline",
        "smaller_architecture",
        "context_length",
        "cross_series_batching"
      ],
      "title": "OptimizationMethod",
      "type": "string"
    },
    "ResourceConstraints": {
      "additionalProperties": false,
      "description": "Inference-time constraints the user sets (spec §3 examples, §8.5).",
      "properties": {
        "latency_batch_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Batch Size"
        },
        "latency_device": {
          "anyOf": [
            {
              "$ref": "#/$defs/Device"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_latency_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Latency Ms"
        },
        "max_memory_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Memory Mb"
        },
        "max_model_size_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Size Mb"
        },
        "min_throughput_per_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Throughput Per S"
        }
      },
      "title": "ResourceConstraints",
      "type": "object"
    },
    "ToolName": {
      "description": "Every tool the spec names: §12 (MCP server), §6.3 (role tools), §11 (tier examples).",
      "enum": [
        "inspect_environment",
        "inspect_dataset",
        "run_diagnostic",
        "search_model_catalog",
        "get_model_evidence",
        "retrieve_methodology",
        "estimate_experiment",
        "write_trial_files",
        "submit_experiment",
        "get_experiment_status",
        "get_experiment_logs",
        "get_experiment_metrics",
        "profile_model",
        "compare_experiments",
        "cancel_experiment",
        "export_artifacts",
        "delegate",
        "propose_trials",
        "escalate",
        "ask_user",
        "create_experiment",
        "share_samples"
      ],
      "title": "ToolName",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Brief for one optimization worker on one passing candidate (spec §6.3, §8.5).",
  "properties": {
    "allowed_tools": {
      "items": {
        "$ref": "#/$defs/ToolName"
      },
      "minItems": 1,
      "title": "Allowed Tools",
      "type": "array"
    },
    "assigned_role": {
      "const": "optimization_worker",
      "default": "optimization_worker",
      "title": "Assigned Role",
      "type": "string"
    },
    "brief_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Brief Id",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/BriefBudget"
    },
    "candidate_artifact_ref": {
      "maxLength": 512,
      "pattern": "^[a-z][a-z0-9_]*:\\S+$",
      "title": "Candidate Artifact Ref",
      "type": "string"
    },
    "candidate_trial_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Candidate Trial Id",
      "type": "string"
    },
    "context_refs": {
      "items": {
        "maxLength": 512,
        "pattern": "^[a-z][a-z0-9_]*:\\S+$",
        "type": "string"
      },
      "title": "Context Refs",
      "type": "array"
    },
    "end_condition": {
      "minLength": 1,
      "title": "End Condition",
      "type": "string"
    },
    "issued_by": {
      "$ref": "#/$defs/ActorRole"
    },
    "max_quality_degradation": {
      "description": "Held-out quality loss the variant may incur (spec §8.5).",
      "minimum": 0,
      "title": "Max Quality Degradation",
      "type": "number"
    },
    "methods": {
      "items": {
        "$ref": "#/$defs/OptimizationMethod"
      },
      "minItems": 1,
      "title": "Methods",
      "type": "array"
    },
    "model_ref": {
      "anyOf": [
        {
          "maxLength": 320,
          "pattern": "^[^\\s@]+@[^\\s@]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Ref"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "output_schema": {
      "const": "OptimizationFinding",
      "default": "OptimizationFinding",
      "title": "Output Schema",
      "type": "string"
    },
    "profile_ref": {
      "anyOf": [
        {
          "maxLength": 512,
          "pattern": "^[a-z][a-z0-9_]*:\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Ref"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_constraints": {
      "$ref": "#/$defs/ResourceConstraints"
    }
  },
  "required": [
    "brief_id",
    "run_id",
    "issued_by",
    "objective",
    "allowed_tools",
    "end_condition",
    "budget",
    "candidate_trial_id",
    "candidate_artifact_ref",
    "methods",
    "target_constraints",
    "max_quality_degradation"
  ],
  "title": "OptimizationBrief",
  "type": "object"
}
