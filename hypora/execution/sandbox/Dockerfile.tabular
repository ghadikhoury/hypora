# Tabular sandbox image (PLAN.md S1.2, spec §14.3). Trial code runs here; platform code never does
# anything but launch it. Build context: this directory (see sandbox/image.py / `make sandbox-image`).
#
# Hardening that lives in the image: pinned base by digest, hash-locked Python packages, no
# compilers or package caches, a non-root default user. Everything else (read-only root filesystem,
# no network, dropped capabilities, no-new-privileges, limits, mounts) is applied by the launcher
# at `docker run` time, because an image cannot enforce it on itself.

# python:3.12-slim (Debian), pinned by digest: same Python minor as the platform (pyproject).
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# LightGBM's wheel links against the system OpenMP runtime. Not hash-pinned: apt installs the
# current libgomp1 of the base image's Debian release at build time (the one unpinned input).
RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Only hash-verified wheels from the lock (no source builds); no dependency resolution at build time.
COPY requirements-tabular.lock /tmp/requirements.lock
RUN pip install --no-deps --require-hashes --only-binary=:all: -r /tmp/requirements.lock \
    && rm /tmp/requirements.lock

# Default non-root user. The launcher always passes an explicit non-root UID (D-012), so this is a
# second line of defense if the image is ever run without one.
RUN groupadd --gid 10001 sandbox \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp --shell /usr/sbin/nologin sandbox
USER 10001:10001

# The fixed mount layout (docs/notes/sandbox-layout.md): /data, /trial, /harness, /out.
WORKDIR /trial
